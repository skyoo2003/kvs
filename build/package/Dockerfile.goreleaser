FROM alpine:3.23

# No RUN in this stage on purpose: every layer is a COPY, so buildx assembles
# linux/arm64 on an amd64 runner with no QEMU. Adding a RUN here brings back
# the need for binfmt emulation (or native arm64 runners).
WORKDIR /kvs
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/kvs /usr/bin/kvs
COPY LICENSE NOTICE /usr/share/licenses/kvs/
COPY .release/third_party_licenses /usr/share/licenses/kvs/THIRD_PARTY_LICENSES

EXPOSE 3456 3457 6379

USER 65534:65534
ENTRYPOINT ["kvs"]
CMD ["serve"]
